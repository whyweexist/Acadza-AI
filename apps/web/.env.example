# Next.js server ONLY. The faculty token must never have NEXT_PUBLIC_ prefix.
API_BASE_URL=http://127.0.0.1:8000
REVIEW_TOKEN=replace-with-same-backend-ADMIN_REVIEW_TOKEN

# The AI providers screen uses a faculty-entered ADMIN_REVIEW_TOKEN.
# It does NOT read REVIEW_TOKEN from the browser or a NEXT_PUBLIC_ setting.
# API keys must remain on the FastAPI server (runtime memory or backend .env).
