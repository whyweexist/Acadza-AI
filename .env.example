# Backend: copy to services/triage/.env or export from shell
SQLITE_PATH=./data/acadza.sqlite3
ADMIN_REVIEW_TOKEN=replace-with-long-random-secret
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_CHEAP_MODEL=gpt-4.1-mini
LLM_STRONG_MODEL=gpt-4.1
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=50
