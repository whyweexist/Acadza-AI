# SQLite-only backend. Copy to repository-root .env (never commit secrets).
SQLITE_PATH=./data/acadza.sqlite3
ADMIN_REVIEW_TOKEN=replace-with-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Choose one: openai | gemini | openrouter.
# When you select a provider in the faculty UI, its key is held only in API
# process memory. Persistent setup uses the environment variables below.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model overrides. Leave blank for provider defaults:
# OpenAI:     gpt-4.1-mini / gpt-4.1
# Gemini:     gemini-2.5-flash / gemini-2.5-pro
# OpenRouter: google/gemini-2.5-flash / google/gemini-2.5-pro
LLM_CHEAP_MODEL=
LLM_STRONG_MODEL=
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=50

# Frontend: apps/web/.env.local (server-side only)
# API_BASE_URL=http://127.0.0.1:8000
# REVIEW_TOKEN=replace-with-the-same-ADMIN_REVIEW_TOKEN
